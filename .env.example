NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Alternative newer Supabase naming:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
RESEND_API_KEY=
# Optional override. Defaults to: "Altura Nova <kontakt@alturanova.se>"
# CONTACT_FROM_EMAIL="Altura Nova <kontakt@alturanova.se>"
# Optional:
# CONTACT_TO_EMAIL=kontakt@alturanova.se

# Hub feature flags. Keep false until the related module is reviewed.
HUB_FEATURE_ACCOUNTING=false
HUB_FEATURE_DOCUMENT_PROCESSING=false
# Requires reviewed Phase E SQL and a production worker. Never enable for the
# development-only memory adapter.
HUB_FEATURE_BACKGROUND_JOBS=false
HUB_FEATURE_EMAIL_AUTOMATION=false
HUB_FEATURE_BANK_IMPORT=false
HUB_FEATURE_SUBSCRIPTION_BILLING=false
HUB_FEATURE_RATE_LIMITING=false
HUB_FEATURE_OBSERVABILITY=false
HUB_FEATURE_EXTERNAL_BACKUPS=false
# Enable only after the relevant phase SQL has been reviewed and applied.
HUB_FEATURE_SAFE_MUTATIONS=false

# Provider choices are non-secret identifiers. Leave empty until a provider,
# cost and data-processing setup have been explicitly approved.
HUB_DOCUMENT_PROCESSOR_PROVIDER=
HUB_JOB_QUEUE_PROVIDER=
HUB_EMAIL_DELIVERY_PROVIDER=
HUB_BANK_IMPORT_PROVIDER=
HUB_SUBSCRIPTION_BILLING_PROVIDER=
HUB_RATE_LIMIT_PROVIDER=
HUB_ERROR_REPORTER_PROVIDER=
HUB_BACKUP_PROVIDER=
